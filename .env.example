# SourceFidelity API – Environment Configuration Template
# Copy this file to `.env` and fill in your values.

# ── Application ──────────────────────────────────────────
DEBUG=true
# APP_NAME=SourceFidelity API
# APP_VERSION=0.1.0

# ── Database ─────────────────────────────────────────────
# Database (PostgreSQL). The POSTGRES_* values must match the credentials the
# postgres container is started with (see docker-compose.yml), and the user/
# password in DATABASE_URL.
DATABASE_URL=postgresql://sourcefidelity:sourcefidelity@localhost:5432/sourcefidelity
POSTGRES_USER=sourcefidelity
POSTGRES_PASSWORD=sourcefidelity
POSTGRES_DB=sourcefidelity

# ── Redis (Celery broker) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── S3 / MinIO ───────────────────────────────────────────
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD start the MinIO container and must
# match S3_ACCESS_KEY / S3_SECRET_KEY below (the app authenticates with these).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sourcefidelity
S3_SECRET_KEY=sourcefidelity123
S3_BUCKET=sourcefidelity-texts
S3_REGION=us-east-1
MINIO_ROOT_USER=sourcefidelity
MINIO_ROOT_PASSWORD=sourcefidelity123

# ── LLM (OpenAI-compatible) ──────────────────────────────
# DeepSeek (default, cheapest): https://platform.deepseek.com/
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_BATCH_SIZE=10
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=8192

# Optional local NLI specialist. Install requirements-nli.txt and prefetch the
# pinned model before enabling. Offline-only loading is the safe default.
RELATIONSHIP_SIGNAL_BACKEND=disabled
RELATIONSHIP_MODEL_NAME=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
RELATIONSHIP_MODEL_REVISION=6f5cf0a2b59cabb106aca4c287eed12e357e90eb
RELATIONSHIP_MODEL_LOCAL_FILES_ONLY=true
RELATIONSHIP_MODEL_DEVICE=cpu
RELATIONSHIP_MODEL_BATCH_SIZE=4

# High-stakes bounded judgment. Keep shadow until a fixed-corpus calibration
# supports enabling adjudication for the selected model/task configuration.
VERIFICATION_JUDGMENT_MODE=shadow
VERIFICATION_JUDGMENT_MAX_PASSAGES=3
VERIFICATION_JUDGMENT_MAX_INPUT_TOKENS=4000
VERIFICATION_JUDGMENT_MAX_OUTPUT_TOKENS=1600
VERIFICATION_RUN_LEASE_SECONDS=900
VERIFICATION_RUN_CLEANUP_INTERVAL_SECONDS=300
VERIFICATION_RUN_MAX_TRANSIENT_MB=200

# ── Cache ────────────────────────────────────────────────
# CACHE_ENABLED=true

# ── Hostile-file inspection ────────────────────────────────
# A required clamd scan runs before PDF parsing. Prefer a Unix socket. If TCP
# is used, keep it on a trusted private network; clamd TCP has no authentication.
# CLAMD_UNIX_SOCKET=/run/clamav/clamd.sock
# CLAMD_HOST=clamav
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_SECONDS=30
# MALWARE_SCAN_REQUIRED=true
# MAX_PDF_PAGES=5000
# MAX_PDF_OBJECTS=250000

# ── OpenAlex (retrieval source) ──────────────────────────
# Contact email retained for Crossref and legacy configuration. OpenAlex's
# former polite-pool mechanism was replaced by API keys in February 2026.
OPENALEX_EMAIL=
# API key required for normal use since February 2026.
# Free daily allowance: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Experimental; fixed-corpus testing found no call reduction. Keep false unless
# running a controlled provider ablation.
OPENALEX_GROUPED_TITLE_PREFETCH_ENABLED=false

# ── CORE (retrieval source, full-text aggregator) ────────
# Free key: https://core.ac.uk/services/api
# v3 docs and token-based rate limits: https://api.core.ac.uk/docs/v3
CORE_API_KEY=

# ── Crossref (metadata-only retrieval source) ────────────
# Polite email (uses OPENALEX_EMAIL as fallback).
# CROSSREF_EMAIL=

# ── Web Search (PDF fallback retrieval) ──────────────────
# After the academic-DB chain fails to find a source, the app can search
# the web for open-access PDF copies (author homepages, repositories, OA).
# Add "web_search" to RETRIEVAL_SOURCES below to enable.
#
# Pluggable search providers (set SEARCH_PROVIDER to one):
#   duckduckgo — unofficial HTML adapter; CAPTCHA-prone, not a durable default
#   searxng    — free, self-hosted metasearch; upstream engines still impose
#                blocking, rate limits and terms (recommended for institutions)
#                The project Compose stack manages and automatically restarts it.
#   tavily     — bounded commercial/free allowance; use as escalation
#   exa        — bounded commercial/free allowance; use as final escalation
#   brave      — commercial API
#   google     — deprecated for new users (closing Jan 2027)
#   Bing Search API is unsupported: Microsoft retired it August 11, 2025.
#
# SEARCH_PROVIDER=duckduckgo
# SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://localhost:8080
# Optional: Compose generates and persists a random secret on first boot when
# this is unset. Set an independent random value for a managed deployment.
# SEARXNG_SECRET=
# SEARCH_ESCALATION_PROVIDERS=tavily,exa
# Hard per-process ceilings; lower these for evaluation runs with scarce credits.
# SEARCH_ESCALATION_MAX_CALLS=tavily:50,exa:25
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# SEARCH_PROVIDER=exa
# EXA_API_KEY=
# SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=

# ── DOI Resolver / Campus Proxy (institutional deployment) ──
# When set, the app constructs {DOI_RESOLVER_URL}{doi} to access papers
# through the university's library proxy/subscription. Dramatically improves
# full-text retrieval for paywalled content.
# Examples:
#   EZproxy:  DOI_RESOLVER_URL=https://proxy.university.edu:2048/login?url=https://doi.org/
#   Custom:   DOI_RESOLVER_URL=https://library.university.edu/fulltext/
# DOI_RESOLVER_URL=

# ── Semantic Scholar (retrieval source) ──────────────────
# Optional; higher rate limits with a key.
# S2_API_KEY=

# ── Google Books (page-count lookup for completeness) ────
# Free key: https://developers.google.com/books/docs/v1/using#APIKey
# Optional — completeness checker works without it (local signals).
GOOGLE_BOOKS_API_KEY=

# ── File processing limits ───────────────────────────────
# MAX_FILE_SIZE_MB=50
# MAX_TEXT_LENGTH_CHARS=100000
# MAX_PAPER_TEXT_LENGTH_CHARS=2000000
# Temporary paper-upload recovery lease and cleanup cadence.
# PAPER_UPLOAD_LEASE_SECONDS=86400
# PAPER_UPLOAD_CLEANUP_INTERVAL_SECONDS=300
# Only temporary is operational. Assessment/course/institutional are reserved
# for the later authorized student-submission repository and currently fail closed.
PAPER_RETENTION_MODE=temporary
# Explicitly enable configured LLM processing for paper citation/relevance text.
# Keep false for deterministic/local-only workflow checks.
PAPER_LLM_PROCESSING_ENABLED=false

# ── Source Repository (Phase 3.5) ─────────────────────────
SOURCE_REPOSITORY_ENABLED=false
# STORAGE_BACKEND=s3
# Publicly downloadable representations without machine-readable licence/OA
# evidence. store_scoped persists them as access-controlled rights_unclassified
# content without making a legal/OA claim. explicit_license_only uses them for
# the current verification run but does not persist them.
PUBLIC_RETRIEVAL_RETENTION_POLICY=store_scoped
# CAMPUS_ACCESS_TTL_DAYS=90
# Expired representations become unusable immediately; this controls how often
# the retryable background worker removes their unreferenced stored objects.
# SOURCE_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
#
# Retrieval source priority order (comma-separated). Sources are tried
# left-to-right; the first to return full text (or abstract) wins.
# Reorder based on your institution's access and empirical hit-rate data.
# Trade-offs:
#   - OpenAlex is fast and broad; putting it early resolves ~60% quickly
#   - CORE has unique OA PDFs; DOI lookups are grouped and quota-header aware
#   - Semantic Scholar is a DOI-only OA supplement using five-item batches
#   - Elsevier must be early if students cite Elsevier-published work
#   - Gutenberg is preferred for complete public-domain editions
#   - Wikisource is the multilingual fallback and fails closed on incomplete indexes
# RETRIEVAL_SOURCES=openalex,crossref,core,elsevier,semantic_scholar,gutenberg,wikisource
# Safe JSON overrides for installed adapters; credentials stay in their own
# secret variables. Unknown provider names fail closed.
# RETRIEVAL_PROVIDER_CONFIG={"openalex":{"batch_size":25},"core":{"timeout_seconds":8,"min_interval_seconds":10,"max_consecutive_failures":2,"max_timeouts_per_run":3,"cooldown_seconds":300},"semantic_scholar":{"enabled":true,"batch_size":5,"max_batches":5,"min_interval_seconds":2,"retry_delays_seconds":[15,60],"cooldown_seconds":900}}
# PROVIDER_HEALTH_STATE_PATH=.sourcefidelity/provider_health.json
# Reuse canonical abstracts for 30 days and negative lookup results for 24
# hours. Increment RETRIEVAL_ACCESS_REVISION whenever subscriptions or approved
# library/proxy routes change so full-text discovery runs immediately.
# RETRIEVAL_LOOKUP_CACHE_ENABLED=true
# RETRIEVAL_ABSTRACT_REFRESH_DAYS=30
# RETRIEVAL_NEGATIVE_REFRESH_HOURS=24
# RETRIEVAL_LOOKUP_CACHE_RETENTION_DAYS=180
# RETRIEVAL_ACCESS_REVISION=1
# Conservative routing heuristic only; confirm rights from source metadata.
# PUBLIC_DOMAIN_CUTOFF_YEAR=1928
#
# STUDENT_URL_MAX_SIZE_MB=50
# STUDENT_URL_TIMEOUT_SECONDS=30

# ── Completeness / Strictness (Phase 3.5 hardening) ──────
# Strictness for instructor uploads:
#   lenient  = accept flagged items with a WARNING (default; individuals)
#   standard = accept but hold for review (institutions)
#   strict   = reject flagged items at upload (HTTP 422)
# STRICTNESS_MODE=lenient
# COMPLETENESS_CHECK_ENABLED=true
# COMPLETENESS_MIN_PAGE_RATIO=0.70

# ── Paywalled PDF caching (copyright policy) ─────────────
# Whether to persist paywalled (campus-access) PDFs to S3.
# When false (default): paywalled PDFs verified in-memory, then discarded.
#   No copyrighted paywalled content persists. Re-checking requires re-download.
# When true: paywalled PDFs cached to S3 for reuse. Efficient, but creates a
#   persistent copy of copyrighted content. Set based on your institution's
#   interpretation of publisher terms.
# CACHE_PAYWALLED_PDFS=false
