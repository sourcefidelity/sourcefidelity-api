# SourceFidelity API – Environment Configuration Template
# Copy this file to `.env` and fill in your values.

# ── Application ──────────────────────────────────────────
DEBUG=true
# APP_NAME=SourceFidelity API
# APP_VERSION=0.1.0

# ── Database ─────────────────────────────────────────────
# Database (PostgreSQL). The POSTGRES_* values must match the credentials the
# postgres container is started with (see docker-compose.yml), and the user/
# password in DATABASE_URL.
DATABASE_URL=postgresql://sourcefidelity:sourcefidelity@localhost:5432/sourcefidelity
POSTGRES_USER=sourcefidelity
POSTGRES_PASSWORD=sourcefidelity
POSTGRES_DB=sourcefidelity

# ── Redis (Celery broker) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── S3 / Silo ────────────────────────────────────────────
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD start the Silo storage container (a
# MinIO continuation that keeps MinIO's setting names) and must
# match S3_ACCESS_KEY / S3_SECRET_KEY below (the app authenticates with these).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sourcefidelity
S3_SECRET_KEY=sourcefidelity123
S3_BUCKET=sourcefidelity-texts
S3_REGION=us-east-1
MINIO_ROOT_USER=sourcefidelity
MINIO_ROOT_PASSWORD=sourcefidelity123

# ── LLM (OpenAI-compatible) ──────────────────────────────
# DeepSeek (default, cheapest): https://platform.deepseek.com/
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# Optional, development-only three-arm evaluation credential.
OPENAI_API_KEY=
# Development-only GLM 5.3 Flash supplemental opinion. Disabled by default;
# credentials alone cannot enable calls. It never changes the formal panel or
# runtime judgment. The price ceilings match the launch discount and fail
# closed when that discount ends or a compliant route is unavailable.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_MAX_PROMPT_USD_PER_MILLION=0.075
OPENROUTER_MAX_COMPLETION_USD_PER_MILLION=0.25

# Qwen API arm (Alibaba Cloud Model Studio, OpenAI-compatible). Development-only,
# fail-closed. The key is bound to the region of the base URL it was created in.
# The provider does not train on inputs but stores call data and offers no
# zero-retention option; set the acknowledgement only after reading its terms.
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_RETENTION_ACKNOWLEDGED=false
QWEN_TERMS_VERIFIED_ON=2026-09-24
QWEN_MAX_PROMPT_USD_PER_MILLION=0.15
QWEN_MAX_COMPLETION_USD_PER_MILLION=0.47

# GLM through the Z.ai API: the Judgment judge, run on every checked paper.
# Fail-closed until keyed and dated. International host api.z.ai;
# open.bigmodel.cn for a key issued on that platform.
ZAI_ENABLED=true
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3-flash
ZAI_REASONING_EFFORT=low
ZAI_TERMS_VERIFIED_ON=
ZAI_MAX_PROMPT_USD_PER_MILLION=0.15
ZAI_MAX_COMPLETION_USD_PER_MILLION=0.50
# JUDGMENT_JUDGES=zai_glm
# LLM_BATCH_SIZE=10
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=8192

# Optional local NLI specialist. Install requirements-nli.txt and prefetch the
# pinned model before enabling. Offline-only loading is the safe default.
RELATIONSHIP_SIGNAL_BACKEND=disabled
RELATIONSHIP_MODEL_NAME=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
RELATIONSHIP_MODEL_REVISION=6f5cf0a2b59cabb106aca4c287eed12e357e90eb
RELATIONSHIP_MODEL_LOCAL_FILES_ONLY=true
RELATIONSHIP_MODEL_DEVICE=cpu
RELATIONSHIP_MODEL_BATCH_SIZE=4

# Optional local semantic retrieval rescue. It runs only after the relevance
# gate finds no connected protected candidate, and remains off until the pinned
# NLI runtime is installed and deployment acceptance has passed.
EVIDENCE_RETRIEVAL_SEMANTIC_BACKEND=disabled
EVIDENCE_RETRIEVAL_SEMANTIC_PREFILTER=32
EVIDENCE_RETRIEVAL_SEMANTIC_MAX_ADDITIONS=4
EVIDENCE_RETRIEVAL_SEMANTIC_BATCH_SIZE=8

# High-stakes bounded judgment. Keep shadow until a fixed-corpus calibration
# supports enabling adjudication for the selected model/task configuration.
VERIFICATION_JUDGMENT_MODE=shadow
VERIFICATION_JUDGMENT_MAX_PASSAGES=3
VERIFICATION_JUDGMENT_MAX_INPUT_TOKENS=4000
VERIFICATION_JUDGMENT_MAX_OUTPUT_TOKENS=1600
VERIFICATION_RUN_LEASE_SECONDS=900
PAPER_SOURCE_RETRIEVAL_LEASE_SECONDS=86400
VERIFICATION_RUN_CLEANUP_INTERVAL_SECONDS=300
VERIFICATION_RUN_MAX_TRANSIENT_MB=200

# ── Cache ────────────────────────────────────────────────
# CACHE_ENABLED=true

# ── Hostile-file inspection ────────────────────────────────
# A required clamd scan runs before PDF parsing. Prefer a Unix socket. If TCP
# is used, keep it on a trusted private network; clamd TCP has no authentication.
# CLAMD_UNIX_SOCKET=/run/clamav/clamd.sock
# CLAMD_HOST=clamav
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_SECONDS=30
# MALWARE_SCAN_REQUIRED=true
# MAX_PDF_PAGES=5000
# MAX_PDF_OBJECTS=250000

# ── OpenAlex (retrieval source) ──────────────────────────
# Contact email retained for Crossref and legacy configuration. OpenAlex's
# former polite-pool mechanism was replaced by API keys in February 2026.
OPENALEX_EMAIL=
# API key required for normal use since February 2026.
# Free daily allowance: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Experimental; fixed-corpus testing found no call reduction. Keep false unless
# running a controlled provider ablation.
OPENALEX_GROUPED_TITLE_PREFETCH_ENABLED=false

# ── CORE (retrieval source, full-text aggregator) ────────
# Free key: https://core.ac.uk/services/api
# v3 docs and token-based rate limits: https://api.core.ac.uk/docs/v3
CORE_API_KEY=

# ── Crossref (metadata-only retrieval source) ────────────
# Polite email (uses OPENALEX_EMAIL as fallback).
# CROSSREF_EMAIL=

# ── Web Search (PDF fallback retrieval) ──────────────────
# After the academic-DB chain fails to find a source, the app can search
# the web for open-access PDF copies (author homepages, repositories, OA).
# Add "web_search" to RETRIEVAL_SOURCES below to enable.
#
# New resolutions: authorized reuse/scholarly/library -> Brave API -> Exa.
# No backup web search by default; set SEARCH_WEB_FALLBACK_PROVIDER=searxng or
# tavily to add one after Exa.
# Stored legacy outcomes are not migrated. Missing required APIs stay incomplete.
# SEARCH_POLICY_VERSION=api-first-search-v2
# SEARCH_SEARXNG_FALLBACK_ENABLED=true
# Set only after confirming account-specific retained-output permissions:
# BRAVE_SEARCH_RETENTION_PERMITTED=false
# Ordinary API-first Brave candidates are operation-local. Durable records
# contain operational counts and independently acquired source provenance.
# BRAVE_SEARCH_TRANSIENT_ENABLED=true
# API-first uses the SAME SEARCH_ESCALATION_MAX_CALLS for Brave and Exa,
# including the first tier. A missing budget entry means zero calls, not unlimited.
# These per-process ceilings do not guarantee a monthly free-credit limit;
# enforce account-side spending limits too. No paid capacity is enabled here.
# Legacy/custom providers (SEARCH_POLICY_VERSION=configured-search-v1):
#   (duckduckgo was removed 2026-09-22: its unofficial HTML endpoint is not
#    permitted by DuckDuckGo's terms, and the official Instant Answer API
#    returns no ranked results for reference titles.)
#   searxng    — free, self-hosted metasearch; upstream engines still impose
#                blocking, rate limits and terms (recommended for institutions)
#                The project Compose stack manages and automatically restarts it.
#   tavily     — bounded commercial/free allowance; use as escalation
#   exa        — bounded commercial/free allowance; use as final escalation
#   brave      — commercial API
#   google     — deprecated for new users (closing Jan 2027)
#   Bing Search API is unsupported: Microsoft retired it August 11, 2025.
#
# Abstract scope prompt version. v6 clarifies only the general-point
# exclusion, which was swallowing a statement about one national industry
# supported by a source stating a different one. Set to abstract-topic-v5 to
# revert if it proves too strict; stored records keep their own version.
# ABSTRACT_SCOPE_POLICY_VERSION=abstract-topic-v5

# SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://localhost:8080
# Ordered fallback groups. Semicolons separate attempts; commas combine
# engines within one SearXNG request. Validate overrides from the deployment.
# Verify an override by checking the engine credited on each result: an
# unrecognised engine name silently falls back to the default engines.
# Verify any engine name against the per-result `engines` field: SearXNG
# answers an unrecognised name with its default engine set instead of an error.
# Judge an engine by relevance, not result count: `bing` returns ten results
# for the first word of a phrase query. `google cse` is the working default.
# SEARXNG_ENGINE_GROUPS=google cse
# Retry only upstream timeouts; access denial, CAPTCHA and rate limits fail
# over immediately to the next configured engine group.
# SEARXNG_TIMEOUT_RETRIES=0
# SEARXNG_TIMEOUT_CIRCUIT_THRESHOLD=3
# SEARXNG_REQUEST_TIMEOUT_SECONDS=15
# SEARXNG_ENGINE_TIMEOUT_SECONDS=12
# The instance must permit a larger timeout_limit before increasing this.
# The Compose template allows up to 6s, while the default remains 3s.
# SearXNG also honors min_interval_seconds in RETRIEVAL_PROVIDER_CONFIG
# (default 1s), shared across local workers using the health-state volume.
# Merge this field into existing provider overrides; do not replace them:
# {"searxng":{"min_interval_seconds":1.0}}
# Optional: Compose generates and persists a random secret on first boot when
# this is unset. Set an independent random value for a managed deployment.
# SEARXNG_SECRET=
# Official bounded fallbacks after the configured primary route. Brave is first
# because its current frozen-paper arm produced the strongest unique admission
# gain; every result still passes the ordinary source-admission boundary.
# SEARCH_ESCALATION_PROVIDERS=brave,tavily,exa
# Hard per-process ceilings; lower these for evaluation runs with scarce credits.
# SEARCH_ESCALATION_MAX_CALLS=brave:100,tavily:50,exa:25
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# SEARCH_PROVIDER=exa
# EXA_API_KEY=
# Bright Data SERP API — a contracted service returning parsed engine results.
# Both values are required: the token authenticates, the zone names the SERP
# product being billed (created in the Bright Data console). An absent token
# is a provider that is not configured, never an empty search.
# ── Automatic re-runs after a provider outage ─────────────
# When a provider that was holding a reference's search incomplete
# recovers, re-run just those references and write a new report version,
# preserving the earlier one. Only providers the completion gate counts
# as blocking trigger a re-run. On by default; set false to stop all
# automatic re-runs (provider health probing continues either way).
# PROVIDER_RECOVERY_REFRESH_ENABLED=true
# PROVIDER_RECOVERY_MAX_JOBS=25

# BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_SERP_ZONE=
# BRIGHTDATA_SERP_ENGINE=google
# Budget for one search in total, retries and their pauses included --
# not per attempt. A failed request is not billed, so the adapter
# retries an upstream gateway fault or rate limit within this budget.
# BRIGHTDATA_TIMEOUT_SECONDS=60.0
# Interface language and result region sent with every query, and the
# collection region pinned in the request. Set them: without them the
# engine and the zone each infer one, so the same query can return
# different results between runs and a recorded empty search is not
# reproducible. Change them to search a different regional market.
# BRIGHTDATA_SEARCH_LANGUAGE=en
# BRIGHTDATA_SEARCH_REGION=us
# SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=

# ── DOI Resolver / Campus Proxy (institutional deployment) ──
# When set, the app constructs {DOI_RESOLVER_URL}{doi} to access papers
# through the university's library proxy/subscription. Dramatically improves
# full-text retrieval for paywalled content.
# Examples:
#   EZproxy:  DOI_RESOLVER_URL=https://proxy.university.edu:2048/login?url=https://doi.org/
#   Custom:   DOI_RESOLVER_URL=https://library.university.edu/fulltext/
# DOI_RESOLVER_URL=

# ── Semantic Scholar (retrieval source) ──────────────────
# Optional; higher rate limits with a key.
# S2_API_KEY=

# ── Google Books (page-count lookup for completeness) ────
# Free key: https://developers.google.com/books/docs/v1/using#APIKey
# Optional — completeness checker works without it (local signals).
GOOGLE_BOOKS_API_KEY=

# ── File processing limits ───────────────────────────────
# MAX_FILE_SIZE_MB=50
# MAX_TEXT_LENGTH_CHARS=100000
# MAX_PAPER_TEXT_LENGTH_CHARS=2000000
# Temporary paper-upload recovery lease and cleanup cadence.
# PAPER_UPLOAD_LEASE_SECONDS=86400
# PAPER_UPLOAD_CLEANUP_INTERVAL_SECONDS=300
# REPORT_PAPER_COPY_ENABLED=true
# FORMATIVE_REPORT_PAPER_RETENTION_DAYS=7
# Authenticated report delivery is disabled by default. For a Personal
# deployment, generate a random token of at least 32 characters, keep it out of
# version control, and send it only as an HTTPS Authorization: Bearer header.
# personal_local is passwordless and must be paired with the loopback API bind.
# Use personal_bearer or institutional_adapter for any shared deployment.
REPORT_AUTH_MODE=personal_local
API_BIND_HOST=127.0.0.1
REPORT_PERSONAL_ACCESS_TOKEN=
# Keep true behind HTTPS. Local HTTP acceptance may explicitly set false.
REPORT_SESSION_TTL_SECONDS=900
REPORT_SESSION_COOKIE_SECURE=true
# Exact comma-separated browser origins only. Do not use `*` with credentials.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# Controlled DOCX rendering is enabled by Compose because the app image owns
# its LibreOffice/font environment. Leave false for a host process unless its
# renderer has been deliberately installed and acceptance-tested.
DOCX_PRESENTATION_RENDERING_ENABLED=false
DOCX_PRESENTATION_RENDERER_EXECUTABLE=soffice
DOCX_PRESENTATION_RENDER_TIMEOUT_SECONDS=120
DOCX_PRESENTATION_RENDER_MAX_MB=100
# Only temporary is operational. Assessment/course/institutional are reserved
# for the later authorized student-submission repository and currently fail closed.
PAPER_RETENTION_MODE=temporary
# Configured LLM processing for paper citation/relevance text.
# Set false only for deterministic/local-only workflow checks.
PAPER_LLM_PROCESSING_ENABLED=true
SOURCE_INSPECTION_ENABLED=false
# Separate permission for bounded observations at the configured remote model.
# Institutional source-specific remote-processing integration remains gated.
SOURCE_INSPECTION_REMOTE_ALLOWED=false
SOURCE_INSPECTION_MAX_CALLS=6
# Separate experimental relationship judgments; ordinary LLM processing does not enable these.
PAPER_EXPERIMENTAL_RELATIONSHIP_JUDGMENTS_ENABLED=false
# Unaccepted comparative passage selector; ordinary relevance remains independent.
PAPER_EXPERIMENTAL_JOINT_SELECTION_ENABLED=false

# ── Source Repository (Phase 3.5) ─────────────────────────
SOURCE_REPOSITORY_ENABLED=false

# Allow an operator-supplied saved publisher page (HTML) to enter source
# intake. It passes the same observed-identity, work-type and article-coverage
# checks as a fetched page, is parsed offline, and is stored only as extracted
# text. Keep disabled unless the deployment intends that provenance.
SUPPLIED_HTML_SOURCE_INTAKE_ENABLED=false

# Optional local OCR for image-only source PDFs. Keep disabled until the
# deployment worker image includes Tesseract and the OCR acceptance checks pass.
PURE_SCAN_OCR_ENABLED=false
PURE_SCAN_OCR_LANGUAGE=eng
PURE_SCAN_OCR_EXECUTABLE=tesseract
PURE_SCAN_OCR_DPI=250
PURE_SCAN_OCR_PAGE_SEGMENTATION_MODE=6
PURE_SCAN_OCR_MAX_PAGES=200
PURE_SCAN_OCR_MAX_PIXELS_PER_PAGE=25000000
PURE_SCAN_OCR_MAX_TOTAL_PIXELS=500000000
PURE_SCAN_OCR_PAGE_TIMEOUT_SECONDS=45
PURE_SCAN_OCR_TOTAL_TIMEOUT_SECONDS=900
PURE_SCAN_OCR_MAX_DERIVATIVE_MB=20
PURE_SCAN_OCR_MIN_MEAN_WORD_CONFIDENCE=70
# STORAGE_BACKEND=s3
# Publicly downloadable representations without machine-readable licence/OA
# evidence. store_scoped persists them as access-controlled rights_unclassified
# content without making a legal/OA claim. explicit_license_only uses them for
# the current verification run but does not persist them.
PUBLIC_RETRIEVAL_RETENTION_POLICY=store_scoped
# CAMPUS_ACCESS_TTL_DAYS=90
# Expired representations become unusable immediately; this controls how often
# the retryable background worker removes their unreferenced stored objects.
# SOURCE_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
#
# Retrieval source priority order (comma-separated). Sources are tried
# left-to-right; the first to return full text (or abstract) wins.
# Reorder based on your institution's access and empirical hit-rate data.
# Trade-offs:
#   - OpenAlex is fast and broad; putting it early resolves ~60% quickly
#   - CORE has unique OA PDFs; DOI lookups are grouped and quota-header aware
#   - Semantic Scholar is a DOI-only OA supplement using five-item batches
#   - Elsevier must be early if students cite Elsevier-published work
#   - Gutenberg is preferred for complete public-domain editions
#   - Wikisource is the multilingual fallback and fails closed on incomplete indexes
# RETRIEVAL_SOURCES=openalex,crossref,core,elsevier,semantic_scholar,gutenberg,wikisource
# Safe JSON overrides for installed adapters; credentials stay in their own
# secret variables. Unknown provider names fail closed.
# RETRIEVAL_PROVIDER_CONFIG={"openalex":{"batch_size":25},"core":{"timeout_seconds":8,"min_interval_seconds":10,"max_consecutive_failures":2,"max_timeouts_per_run":3,"cooldown_seconds":300},"semantic_scholar":{"enabled":true,"batch_size":5,"max_batches":5,"min_interval_seconds":2,"retry_delays_seconds":[15,60],"cooldown_seconds":900}}
# PROVIDER_HEALTH_STATE_PATH=.sourcefidelity/provider_health.json
# PROVIDER_RECOVERY_MAX_JOBS=25
# PROVIDER_HEALTH_PROBE_INTERVAL_SECONDS=60
# Reuse canonical abstracts for 30 days and negative lookup results for 24
# hours. Increment RETRIEVAL_ACCESS_REVISION whenever subscriptions or approved
# library/proxy routes change so full-text discovery runs immediately.
# RETRIEVAL_LOOKUP_CACHE_ENABLED=true
# RETRIEVAL_ABSTRACT_REFRESH_DAYS=30
# RETRIEVAL_NEGATIVE_REFRESH_HOURS=24
# RETRIEVAL_LOOKUP_CACHE_RETENTION_DAYS=180
# RETRIEVAL_ACCESS_REVISION=1
# Conservative routing heuristic only; confirm rights from source metadata.
# PUBLIC_DOMAIN_CUTOFF_YEAR=1928
#
# STUDENT_URL_MAX_SIZE_MB=50
# STUDENT_URL_TIMEOUT_SECONDS=30

# ── Completeness / Strictness (Phase 3.5 hardening) ──────
# Strictness for instructor uploads:
#   lenient  = accept flagged items with a WARNING (default; individuals)
#   standard = accept but hold for review (institutions)
#   strict   = reject flagged items at upload (HTTP 422)
# STRICTNESS_MODE=lenient
# COMPLETENESS_CHECK_ENABLED=true
# COMPLETENESS_MIN_PAGE_RATIO=0.70

# ── Paywalled PDF caching (copyright policy) ─────────────
# Whether to persist paywalled (campus-access) PDFs to S3.
# When false (default): paywalled PDFs verified in-memory, then discarded.
#   No copyrighted paywalled content persists. Re-checking requires re-download.
# When true: paywalled PDFs cached to S3 for reuse. Efficient, but creates a
#   persistent copy of copyrighted content. Set based on your institution's
#   interpretation of publisher terms.
# CACHE_PAYWALLED_PDFS=false
DEVELOPMENT_RETAIN_DISCOVERY_LEAD_URLS=false

# Speculative discovery candidates get a shorter total deadline than the
# URL a student actually cited. Lowering it trades slow-yet-real sources for
# wall time; validate against retrieval counts, not against run duration.
# DISCOVERY_CANDIDATE_TIMEOUT_SECONDS=30.0

# ---- Judgment (ARCHITECTURE §7) ----------------------------------------------
# Part of every interactive report; runs at check time with the configured judge.
# Optional spend limits in USD (unset = no limit; spend is always recorded).
# JUDGMENT_MAX_USD_PER_REPORT=0.50
# JUDGMENT_MAX_USD_PER_DAY=5.00
# Wider-search sentence reserve: paper_retention | until_grades_released | off
# JUDGMENT_RESERVE_RETENTION=paper_retention
